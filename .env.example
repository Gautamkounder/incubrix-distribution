# Every setting the service reads. Copy to .env (docker compose picks it up automatically).
APP_NAME=incubrix-distribution
LOG_LEVEL=INFO
# SIMULATION_MODE=true means mock platforms, no real accounts or keys needed.
SIMULATION_MODE=true
DATABASE_URL=sqlite:///./dev.db
HTTP_TIMEOUT_S=10
PUBLIC_BASE_URL=http://localhost:8000
# Used to sign job callbacks (X-IncuBrix-Signature, HMAC-SHA256).
CALLBACK_SECRET=change-me
# Storage: local (folder, default) or s3 (RustFS or any S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=incubrix-outputs
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
